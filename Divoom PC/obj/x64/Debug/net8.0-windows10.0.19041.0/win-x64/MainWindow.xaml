<?xml version="1.0" encoding="utf-8"?>
<local:WindowEx x:ConnectionId='1'
    x:Class="DivoomPC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DivoomPC.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d"
    Title="Divoom PC">

    <Grid>
        <NavigationView x:ConnectionId='2' x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                                                                   >
            
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Главная" Tag="home"/>
                <NavigationViewItem Icon="Setting" Content="Настройки" Tag="settings"/>
            </NavigationView.MenuItems>

            <Frame x:ConnectionId='6' x:Name="ContentFrame"/>

            <NavigationView.PaneFooter>
                <StackPanel>
                    <Button x:ConnectionId='7' x:Name="MinimizeButton" 
                                                        
                            ToolTipService.ToolTip="Minimize to tray">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE921;"/>
                            <TextBlock Text="Minimize to tray" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>
        </NavigationView>

        <tb:TaskbarIcon x:ConnectionId='3' x:Name="NotifyIcon"
                        ToolTipText="Divoom PC"
                        IconSource="/Divoom.ico"
                                                                  
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:ConnectionId='4' Text="Restore"                                  />
                    <MenuFlyoutItem x:ConnectionId='5' Text="Exit"                                />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</local:WindowEx>


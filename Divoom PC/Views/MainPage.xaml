<Page
    x:Class="DivoomPC.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DivoomPC.Views"
    xmlns:controls="using:DivoomPC.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
            <ComboBox Header="Select Device"
                      ItemsSource="{x:Bind ViewModel.Devices}"
                      SelectedIndex="{x:Bind ViewModel.SelectedDeviceIndex, Mode=TwoWay}"
                      DisplayMemberPath="DeviceName"
                      PlaceholderText="No devices found"/>

            <ComboBox Header="Select LCD"
                      ItemsSource="{x:Bind ViewModel.LCDOptions}"
                      SelectedIndex="{x:Bind ViewModel.SelectedLCDIndex, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.ShowLCDSelector, Mode=OneWay}"
                      PlaceholderText="Select LCD"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{x:Bind ViewModel.MonitoringCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:Card Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}"
                                         Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Grid.Row="1"
                                         Text="{Binding Value}"
                                         Style="{StaticResource TitleTextBlockStyle}"
                                         Margin="0,8,0,0"/>
                            </Grid>
                        </controls:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page> 